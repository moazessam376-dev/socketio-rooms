{
  "name": "socketio-rooms",
  "version": "1.0.0",
  "description": "Socket.IO chat rooms with two-layer reconnection and Redis-backed scaling across instances",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:client": "esbuild client/app.ts --bundle --format=iife --outfile=public/app.js",
    "dev": "npm run build:client && tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
